# Silent-payment indexer per network. At least one must be set; the app refuses to scan on a
# network with no indexer configured.
#
# INDEXER_BASE_URL is a deprecated alias for INDEXER_BASE_URL_MAINNET and is still honoured.
INDEXER_BASE_URL=
INDEXER_BASE_URL_MAINNET=https://your-mainnet-indexer-url-here/
INDEXER_BASE_URL_TESTNET4=https://your-testnet4-indexer-url-here/
INDEXER_BASE_URL_SIGNET=https://your-signet-indexer-url-here/

# Optional .onion address of each network's indexer, used when Tor is enabled. A network only ever
# talks to its own onion address, so a chain with none is reached over clearnet (or not at all in
# Tor-only mode). INDEXER_ONION_URL is the mainnet one and keeps its original name.
INDEXER_ONION_URL=http://your-mainnet-indexer-onion-address.onion
INDEXER_ONION_URL_TESTNET4=http://your-testnet4-indexer-onion-address.onion
INDEXER_ONION_URL_SIGNET=http://your-signet-indexer-onion-address.onion
