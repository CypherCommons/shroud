# Everything here is optional. Each network ships its own silent-payment indexer (and .onion
# address) in modules/network.ts; set a value only to point the app somewhere else, e.g. your own
# indexer. A blank value keeps the shipped default. Don't leave placeholder text in a value: it
# would replace the real address.
#
# Expo CLI inlines EXPO_PUBLIC_* variables when it bundles the app: from this file locally, and from
# the EAS environment in EAS builds. Published OTA updates ignore this file (see RELEASE.md).
#
# EXPO_PUBLIC_INDEXER_BASE_URL is a deprecated alias for EXPO_PUBLIC_INDEXER_BASE_URL_MAINNET and is
# still honoured.
EXPO_PUBLIC_INDEXER_BASE_URL=
EXPO_PUBLIC_INDEXER_BASE_URL_MAINNET=
EXPO_PUBLIC_INDEXER_BASE_URL_TESTNET4=
EXPO_PUBLIC_INDEXER_BASE_URL_SIGNET=

# .onion address of each network's indexer, used when Tor is enabled (plain http://). A network only
# ever talks to its own onion address. EXPO_PUBLIC_INDEXER_ONION_URL is mainnet's.
EXPO_PUBLIC_INDEXER_ONION_URL=
EXPO_PUBLIC_INDEXER_ONION_URL_TESTNET4=
EXPO_PUBLIC_INDEXER_ONION_URL_SIGNET=
